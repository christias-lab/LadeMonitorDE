  "info": {
    "description": "Normalized observability APIs for public EV charging infrastructure.",
    "title": "LadePulse DE API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/map": {
      "get": {
        "operationId": "map_features_v1_map_get",
        "parameters": [
          {
            "in": "query",
            "name": "west",
            "required": true,
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "title": "West",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "south",
            "required": true,
            "schema": {
              "maximum": 90,
              "minimum": -90,
              "title": "South",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "east",
            "required": true,
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "title": "East",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "north",
            "required": true,
            "schema": {
              "maximum": 90,
              "minimum": -90,
              "title": "North",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "zoom",
            "required": true,
            "schema": {
              "maximum": 18,
              "minimum": 3,
              "title": "Zoom",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "at",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
